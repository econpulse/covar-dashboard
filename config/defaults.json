    "EUR": {
      "allow_pre_1999_proxy": true,
      "proxy_code": "ECWGM1M",
      "proxy_type": "DEM_DEPOSIT_PROXY",
      "proxy_until": "1998-12-31",
      "proxy_description": "BD EU-MARK 1M Einlage vor 1999 als bewusst gewählter EUR-Cash-Proxy (vermutete DEM-Herkunft dokumentiert; ab 1999 EUR-Reihe)"
    }
  },
  "fx_policy": {
    "legacy_gbp_spot_code": "USSTBOE",
