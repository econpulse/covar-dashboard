  "risk_models": {
    "sample_full": {
      "id": "sample_full",
      "label": "Sample-Kovarianz (Vollhistorie)",
      "estimator": "SAMPLE",
      "window_mode": "FULL",
      "window_months": null,
      "missing_mode": "COMPLETE_CASE",
      "description": "Klassische Stichprobenkovarianz auf dem vollständigen gemeinsamen Zeitraum als Diagnosebenchmark."
    },
    "shrinkage_long": {
      "id": "shrinkage_long",
      "label": "Langfrist-Shrinkage (Vollhistorie)",
      "estimator": "SHRINKAGE",
      "shrinkage_target": "CONSTANT_CORRELATION",
      "window_mode": "FULL",
      "window_months": null,
      "missing_mode": "COMPLETE_CASE",
      "description": "Ledoit-Wolf-Shrinkage gegen konstante Korrelation auf der gemeinsamen Vollhistorie."
    },
    "shrinkage_120m": {
      "id": "shrinkage_120m",
      "label": "Mittelfrist-Shrinkage (120 Monate)",
      "estimator": "SHRINKAGE",
      "shrinkage_target": "CONSTANT_CORRELATION",
      "window_mode": "ROLLING",
      "window_months": 120,
      "missing_mode": "COMPLETE_CASE",
      "description": "Ledoit-Wolf-Shrinkage auf den letzten 120 Monaten."
    },
    "ewma_24m": {
      "id": "ewma_24m",
      "label": "EWMA (HWZ 24M, Fenster 120M)",
      "estimator": "EWMA",
      "halflife_months": 24,
      "window_mode": "ROLLING",
      "window_months": 120,
      "regularization_gamma": 0.05,
      "missing_mode": "COMPLETE_CASE",
      "description": "Exponentiell gewichtete Kovarianz (Halbwertszeit 24 Monate, max. 120 Monate) mit dokumentierter Diagonal-Regularisierung (5%)."
    },
    "factor_completed": {
      "id": "factor_completed",
      "label": "Faktor-Momentenmodell (Kurze Historien)",
      "estimator": "FACTOR_COMPLETED",
      "shrinkage_target": "CONSTANT_CORRELATION",
      "window_mode": "FULL",
      "window_months": null,
      "missing_mode": "FACTOR_RECONSTRUCTION",
      "description": "Direkte gemeinsame Faktor-Momentenschätzung für kürzere Zeitreihen auf Basis wirtschaftlich zulässiger Langfrist-Donoren unter Erhalt der PSD-Struktur."
    },
    "crisis_stress": {
      "id": "crisis_stress",
      "label": "Stress-Kovarianz (Beobachtete Krisenfenster)",
      "estimator": "CRISIS_STRESS",
      "window_mode": "CRISIS",
      "window_months": 60,
      "regularization_gamma": 0.05,
      "missing_mode": "COMPLETE_CASE",
      "description": "PSD-konsistente Kovarianzmatrix über die historisch volatilsten Stressmonate des gemeinsamen Zeitraums."
    }
  },
